# Copie este arquivo para .env e preencha as chaves. NUNCA commite o .env.

# Provedor do agente: groq | gemini | ollama
LLM_PROVIDER=groq

# Groq (https://console.groq.com) - modelo grande para sintetizar/comparar, pequeno para os demais nós
GROQ_API_KEY=
GROQ_MODEL_MAIN=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b

# Gemini (https://aistudio.google.com) - usado como juiz na avaliação
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama (opcional, local)
OLLAMA_MODEL=qwen2.5:3b
